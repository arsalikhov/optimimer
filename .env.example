# Copy to backend/.env (or export in your shell) before `cargo run`.

# OpenRouter — powers the "AI Step" nodes. Without it, AI steps return a
# clearly-labelled [mock:...] response so the builder still runs end-to-end.
OPENROUTER_API_KEY=

# Telegram — the primary interface. Get a token from @BotFather, set it here,
# then restart the backend. Unset = bot disabled (web UI still works).
TELEGRAM_BOT_TOKEN=

# Notion integration — powers the Notion tool node. Create an internal
# integration at https://www.notion.so/my-integrations, copy its token, and
# share the pages/databases you want to reach with that integration.
NOTION_TOKEN=

# Where workflows are persisted (JSON file). Optional.
OPTIMIMER_DATA=workflows.json
