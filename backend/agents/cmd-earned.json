{
  "name": "Earned (command)",
  "nodes": [
    {
      "id": "trigger_1",
      "type": "trigger",
      "position": { "x": 40, "y": 200 },
      "data": { "label": "/earned" }
    },
    {
      "id": "parse",
      "type": "llm",
      "position": { "x": 320, "y": 200 },
      "data": {
        "label": "Parse income",
        "model": "anthropic/claude-sonnet-4.6",
        "system": "You turn an income description into JSON for a Notion 'Finances' database. Output ONLY minified JSON — no prose, no code fences. Keys: amount (a POSITIVE number, digits only, no currency symbol; if unknown use 0), source (short label for where it came from, e.g. 'Paycheck', 'Refund', 'Freelance'; if unknown use 'Income'), category (EXACTLY 'Salary' if this is regular wages/payroll/pay, otherwise 'Income'), date (YYYY-MM-DD). For date: if the text states one, use it; otherwise use TODAY, whose date is the first 10 characters of NOW.",
        "prompt": "NOW: {{input.now}}\n\nINCOME:\n{{input.text}}"
      }
    },
    {
      "id": "create",
      "type": "notion",
      "position": { "x": 640, "y": 200 },
      "data": {
        "label": "Create transaction",
        "op": "create_page",
        "database_id": "{{env.FINANCES_DB_ID}}",
        "title": "{{parse.json.source}}",
        "title_prop": "Name",
        "properties_json": "{\"Amount\":{\"number\":{{num:parse.json.amount}}},\"Direction\":{\"select\":{\"name\":\"Income\"}},\"Category\":{\"select\":{\"name\":\"{{parse.json.category}}\"}},\"Date\":{\"date\":{\"start\":\"{{parse.json.date}}\"}},\"Source\":{\"select\":{\"name\":\"Manual\"}}}",
        "content": "{{input.text}}"
      }
    },
    {
      "id": "out",
      "type": "output",
      "position": { "x": 960, "y": 200 },
      "data": { "label": "Confirm", "value": "<!rich><b>Logged income</b>\n<table><tr><td>Amount</td><td>${{html:parse.json.amount}}</td></tr><tr><td>Source</td><td>{{html:parse.json.source}}</td></tr><tr><td>Date</td><td>{{html:parse.json.date}}</td></tr></table>\n<a href=\"{{html:create.url}}\">Link to Notion page</a>" }
    }
  ],
  "edges": [
    { "id": "e1", "source": "trigger_1", "target": "parse" },
    { "id": "e2", "source": "parse", "target": "create" },
    { "id": "e3", "source": "create", "target": "out" }
  ]
}
