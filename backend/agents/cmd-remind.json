{
  "name": "Remind (command)",
  "nodes": [
    {
      "id": "trigger_1",
      "type": "trigger",
      "position": { "x": 40, "y": 220 },
      "data": { "label": "/remind" }
    },
    {
      "id": "parse",
      "type": "llm",
      "position": { "x": 300, "y": 220 },
      "data": {
        "label": "Parse reminder",
        "model": "anthropic/claude-haiku-4.5",
        "system": "Turn a reminder request into JSON. Output ONLY minified JSON — no prose, no code fences. NEVER compute calendar dates or times yourself; only EXTRACT time tokens into a `when` object (code resolves them). `when` fields (include only those mentioned): in_minutes, in_hours, in_days (0 today, 1 tomorrow, N for 'in N days'), weekday ('monday'..'sunday'), weekday_next (true for 'next <weekday>'), month, day, year, hour (0-23; '2pm'=>14, '5pm'=>17, 'noon'=>12, 'morning'=>9, 'tonight'=>20), minute. If no time of day is given, omit hour/minute (code defaults to 4pm). Output keys: when (the token object), title (short Notion title), message (the Telegram reminder text, prefixed with '⏰ Reminder: ').",
        "prompt": "{{input.text}}"
      }
    },
    {
      "id": "dt",
      "type": "datetime",
      "position": { "x": 560, "y": 220 },
      "data": { "label": "Resolve time", "spec": "{{parse.json.when}}", "tz": "{{input.tz}}", "default_hour": "16", "duration_minutes": "0" }
    },
    {
      "id": "far_cond",
      "type": "condition",
      "position": { "x": 820, "y": 220 },
      "data": { "label": ">12h away?", "left": "{{dt.far}}", "op": "eq", "right": "true" }
    },
    {
      "id": "create",
      "type": "notion",
      "position": { "x": 1080, "y": 120 },
      "data": {
        "label": "Log to LifeOS",
        "op": "create_page",
        "database_id": "{{env.LIFEOS_DB_ID}}",
        "title": "{{parse.json.title}}",
        "title_prop": "Name",
        "properties_json": "{\"Type\":{\"select\":{\"name\":\"Reminder\"}},\"Category\":{\"select\":{\"name\":\"Personal\"}},\"Status\":{\"status\":{\"name\":\"Not started\"}},\"Date\":{\"date\":{\"start\":\"{{dt.rfc3339}}\"}}}",
        "content": "{{input.text}}"
      }
    },
    {
      "id": "sched_far",
      "type": "schedule",
      "position": { "x": 1340, "y": 120 },
      "data": { "label": "Schedule ping", "fire_at": "{{dt.rfc3339}}", "chat_id": "{{input.chat_id}}", "message": "{{parse.json.message}}", "page_id": "", "properties_json": "" }
    },
    {
      "id": "out_far",
      "type": "output",
      "position": { "x": 1600, "y": 120 },
      "data": { "label": "Confirm (logged)", "value": "⏰ Reminder set for {{dt.human}}.\nLogged: {{create.url}}" }
    },
    {
      "id": "sched_near",
      "type": "schedule",
      "position": { "x": 1080, "y": 340 },
      "data": { "label": "Schedule ping (no Notion)", "fire_at": "{{dt.rfc3339}}", "chat_id": "{{input.chat_id}}", "message": "{{parse.json.message}}", "page_id": "", "properties_json": "" }
    },
    {
      "id": "out_near",
      "type": "output",
      "position": { "x": 1340, "y": 340 },
      "data": { "label": "Confirm (ping only)", "value": "⏰ Reminder set for {{dt.human}}." }
    }
  ],
  "edges": [
    { "id": "e1", "source": "trigger_1", "target": "parse" },
    { "id": "e2", "source": "parse", "target": "dt" },
    { "id": "e3", "source": "dt", "target": "far_cond" },
    { "id": "e4", "source": "far_cond", "target": "create", "sourceHandle": "true" },
    { "id": "e5", "source": "create", "target": "sched_far" },
    { "id": "e6", "source": "sched_far", "target": "out_far" },
    { "id": "e7", "source": "far_cond", "target": "sched_near", "sourceHandle": "false" },
    { "id": "e8", "source": "sched_near", "target": "out_near" }
  ]
}
