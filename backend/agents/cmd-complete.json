{
  "name": "Complete (command)",
  "nodes": [
    {
      "id": "trigger_1",
      "type": "trigger",
      "position": { "x": 40, "y": 200 },
      "data": { "label": "/complete" }
    },
    {
      "id": "find",
      "type": "notion",
      "position": { "x": 320, "y": 200 },
      "data": {
        "label": "Find open item",
        "op": "query_database",
        "database_id": "{{env.LIFEOS_DB_ID}}",
        "filter_json": "{\"and\":[{\"property\":\"Name\",\"title\":{\"contains\":\"{{input.text}}\"}},{\"property\":\" Complete\",\"checkbox\":{\"equals\":false}}]}"
      }
    },
    {
      "id": "pick",
      "type": "llm",
      "position": { "x": 620, "y": 200 },
      "data": {
        "label": "Pick best match",
        "model": "anthropic/claude-haiku-4.5",
        "system": "You select the Notion page the user means to complete. Output ONLY minified JSON: {\"id\":\"<page id or empty string>\",\"title\":\"<its title>\",\"found\":true|false}. Choose the single best match by title; if nothing reasonably matches, found is false and id is \"\".",
        "prompt": "User wants to complete: \"{{input.text}}\".\nCandidates (Notion query result): {{find}}"
      }
    },
    {
      "id": "found_cond",
      "type": "condition",
      "position": { "x": 900, "y": 200 },
      "data": { "label": "Found?", "left": "{{pick.json.found}}", "op": "eq", "right": "true" }
    },
    {
      "id": "update",
      "type": "notion",
      "position": { "x": 1180, "y": 120 },
      "data": {
        "label": "Mark done",
        "op": "update_page",
        "page_id": "{{pick.json.id}}",
        "properties_json": "{\" Complete\":{\"checkbox\":true},\"Status\":{\"status\":{\"name\":\"Done\"}}}"
      }
    },
    {
      "id": "done_out",
      "type": "output",
      "position": { "x": 1460, "y": 120 },
      "data": { "label": "Done", "value": "Marked done: {{pick.json.title}}" }
    },
    {
      "id": "miss_out",
      "type": "output",
      "position": { "x": 1180, "y": 300 },
      "data": { "label": "Not found", "value": "Couldn't find an open item matching '{{input.text}}'." }
    }
  ],
  "edges": [
    { "id": "e1", "source": "trigger_1", "target": "find" },
    { "id": "e2", "source": "find", "target": "pick" },
    { "id": "e3", "source": "pick", "target": "found_cond" },
    { "id": "e4", "source": "found_cond", "target": "update", "sourceHandle": "true" },
    { "id": "e5", "source": "update", "target": "done_out" },
    { "id": "e6", "source": "found_cond", "target": "miss_out", "sourceHandle": "false" }
  ]
}
