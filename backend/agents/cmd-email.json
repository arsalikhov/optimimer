{
  "name": "Email (command)",
  "nodes": [
    {
      "id": "trigger_1",
      "type": "trigger",
      "position": { "x": 40, "y": 200 },
      "data": { "label": "/email" }
    },
    {
      "id": "parse",
      "type": "llm",
      "position": { "x": 320, "y": 200 },
      "data": {
        "label": "Draft email",
        "model": "anthropic/claude-haiku-4.5",
        "system": "Turn a request into an email. Output ONLY minified JSON — no prose, no code fences. Keys: to (recipient email address, or \"\" if none given), subject (short), text (plain-text body), confirmation (one-line human summary).",
        "prompt": "{{input.text}}"
      }
    },
    {
      "id": "key_cond",
      "type": "condition",
      "position": { "x": 620, "y": 200 },
      "data": { "label": "API key set?", "left": "{{env.RESEND_API_KEY}}", "op": "ne", "right": "" }
    },
    {
      "id": "send",
      "type": "http",
      "position": { "x": 900, "y": 120 },
      "data": {
        "label": "Send via Resend",
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "headers_json": "{\"Authorization\":\"Bearer {{env.RESEND_API_KEY}}\"}",
        "body": "{\"from\":\"{{env.EMAIL_FROM}}\",\"to\":[\"{{parse.json.to}}\"],\"subject\":\"{{parse.json.subject}}\",\"text\":\"{{parse.json.text}}\"}"
      }
    },
    {
      "id": "sent_out",
      "type": "output",
      "position": { "x": 1180, "y": 120 },
      "data": { "label": "Sent", "value": "📧 Sent to {{parse.json.to}} (HTTP {{send.status}})" }
    },
    {
      "id": "mock_out",
      "type": "output",
      "position": { "x": 900, "y": 300 },
      "data": { "label": "Mocked", "value": "📧 (mocked — set RESEND_API_KEY + EMAIL_FROM to send)\nTo: {{parse.json.to}}\nSubject: {{parse.json.subject}}\n\n{{parse.json.text}}" }
    }
  ],
  "edges": [
    { "id": "e1", "source": "trigger_1", "target": "parse" },
    { "id": "e2", "source": "parse", "target": "key_cond" },
    { "id": "e3", "source": "key_cond", "target": "send", "sourceHandle": "true" },
    { "id": "e4", "source": "send", "target": "sent_out" },
    { "id": "e5", "source": "key_cond", "target": "mock_out", "sourceHandle": "false" }
  ]
}
