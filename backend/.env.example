# Copy this file to `backend/.env` and fill in what you need, then `cargo run`.
# main.rs loads it via dotenvy. Two ways to supply these values:
#   • Plain .env file (this file) — simplest, but secrets sit unencrypted on disk.
#     Make sure .env stays gitignored. Fine for a personal box; weaker than below.
#   • A secret manager (e.g. Infisical) injecting them at launch — nothing on disk.
#     See `bun run dev:secure` in the README for the managed path.
#
# All keys are optional for wiring tests: with them unset, LLM steps return
# [mock:…], so the graphs still run offline.

# --- Core ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=        # from @BotFather. Required for the bot to run.
OPENROUTER_API_KEY=        # LLM calls (command agents) AND voice transcription.

# --- Access & onboarding ------------------------------------------------------
# A Telegram bot is publicly discoverable, so access is DENY-BY-DEFAULT. Chats
# get in by PAIRING: the first person to send the setup code becomes the owner
# (the bot then runs a short in-chat setup: name, timezone, categories,
# machines); the owner can mint one-time invite codes for others. Paired chats
# and every setting they choose live in the SQLite db — nothing personal is in
# the source or the binary. Leave the code unset and the bot generates one and
# prints it in the log on start (deploy/install.sh prints it for you).
# OPTIMIMER_SETUP_CODE=K7QD-3MXP
# Optional static allowlist of chat ids on top of pairing (legacy).
# TELEGRAM_ALLOWED_CHAT_IDS=

# Voice notes are transcribed via OpenRouter (model mistralai/voxtral-small-24b-2507),
# then routed to a command. Override the model with TRANSCRIBE_MODEL (optional).
# TRANSCRIBE_MODEL=mistralai/voxtral-small-24b-2507
# Bias transcription toward your domain terms so an acronym isn't misheard.
# Comma-separated names/brands/jargon. Normally grown by chatting ("remember
# the word Kubernetes for voice notes"); this env var overrides the stored list.
# TRANSCRIBE_VOCAB=Optimimer, Obsidian, Telegram

# --- Vault (/todo, /note, summaries) -----------------------------------------
# Folder of Markdown files with YAML frontmatter — an Obsidian vault. Point it at
# the folder Obsidian syncs (Obsidian Sync / Syncthing) so captures appear on
# every device; Obsidian Bases can filter/sort them by the frontmatter properties.
# Layout: notes/, tasks/, summaries/, finance/ (ledger mirror) + Finances.base.
# Relative paths resolve from the working dir.
VAULT_DIR=vault
# Top-level categories every task/note gets (projects nest under one). Defaults:
# Admin, Work, Fitness, Home, Finance, Learning, Social, Travel, Personal. The
# owner picks their own during setup (stored in the db); this env var overrides
# that. Comma-separated "Name:hint" pairs; the last is the catch-all.
# VAULT_CATEGORIES=Admin:chores and appointments, Work:my job, Fitness:training, Personal:everything else

# Wake-on-LAN targets, "name=MAC@interface,…" (interface defaults to eth0).
# Normally registered by chatting ("add machine desktop aa:bb:cc:dd:ee:ff");
# this env var overrides the stored list.
# MACHINES=desktop=aa:bb:cc:dd:ee:ff@eth0

# --- Finance (/spent, /earned, /balance, CSV import) --------------------------
# Transactions live in the SQLite db (see OPTIMIMER_DB). Money math runs in Rust;
# CSV import classifies + de-dupes rows. Review with /transactions.
# FINANCE_PLACEHOLDERS=1   # seed an EMPTY ledger with labelled sample rows (purged on first real entry)
# Exact e-transfer amounts treated as rent -> Housing expense (comma-separated).
# Off unless set; use your own amount(s), e.g.:
# RENT_AMOUNTS=1500,1700
# Vision model for receipt-photo OCR (optional override).
# OCR_MODEL=anthropic/claude-sonnet-4.6
# Model that normalizes/categorizes CSV statement rows (optional override).
# FINANCE_MODEL=anthropic/claude-sonnet-4.6

# --- Agent mode (experimental) ------------------------------------------------
# Every message is handled by one tool-calling model (no slash commands): it
# reads a bounded context (rolling summary + last MEMORY_WINDOW turns) and acts
# through tools. Must support function calling.
# AGENT_MODEL=anthropic/claude-sonnet-4.6
# Long-term memory: a cheap model extracts people/projects/facts after each
# exchange (mirrored to vault/memory/ as wikilinked notes) and folds old turns
# into a rolling summary; the agent calls `recall` for anything older.
# MEMORY_MODEL=anthropic/claude-haiku-4.5
# MEMORY_WINDOW=12

# Default timezone for parsing "4pm", "tomorrow", etc. The owner's choice during
# setup is stored in the db; this env var overrides it. Per-chat overrides come
# from telling the bot your timezone or sharing a location pin.
# DEFAULT_TZ=UTC

# --- /email (optional) --------------------------------------------------------
# Until both are set, /email just shows a mocked preview instead of sending.
RESEND_API_KEY=            # https://resend.com — used as a bearer token.
EMAIL_FROM=               # verified sender, e.g. "Me <me@yourdomain.com>"

# --- Data / server (optional; sensible defaults) ------------------------------
# Embedded SQLite database (settings, paired chats, ledger, memory, schedules, lists):
# OPTIMIMER_DB=optimimer.db
# HTTP API bind address. Localhost-only by default so the (unauthenticated) agent
# API isn't exposed on your LAN; set 0.0.0.0:8799 only behind a trusted network
# or reverse proxy. Reach the web UI remotely over an SSH tunnel instead.
# OPTIMIMER_BIND=127.0.0.1:8799
# Agents directory (cmd-*.json re-seeded on startup):
# OPTIMIMER_AGENTS_DIR=agents
# Legacy JSON stores — imported once into SQLite if present, then ignored:
# OPTIMIMER_DATA=workflows.json
# OPTIMIMER_SCHEDULE_DATA=schedules.json
# OPTIMIMER_TZ_DATA=chat_tz.json
# Conversation summaries: forward a batch of messages (or send a long voice memo)
# and the bot replies with a summary + transcript, saved to the vault (summaries/).
# CONVO_MODEL=anthropic/claude-sonnet-4.6
# VOICE_MEMO_SECS=45        # voice notes this long or longer are memos; so is any clip opening with
#                           # "memo" / "note to self", or a short clip the router can't place
# FORWARD_SETTLE_SECS=4     # quiet time after the last forward before the batch is closed
# FORWARD_PEEK_SECS=1       # extra poll after a plain message to catch forwards behind it (0 = off)
# FORWARD_NOTE_TTL_SECS=600 # how long "what are these about?" waits for a reply
