# Copy this file to `backend/.env` and fill in what you need, then `cargo run`.
# main.rs loads it via dotenvy. Two ways to supply these values:
#   • Plain .env file (this file) — simplest, but secrets sit unencrypted on disk.
#     Make sure .env stays gitignored. Fine for a personal box; weaker than below.
#   • A secret manager (e.g. Infisical) injecting them at launch — nothing on disk.
#     See `bun run dev:secure` in the README for the managed path.
#
# All keys are optional for wiring tests: with them unset, LLM steps return
# [mock:…] and Notion calls are mocked, so the graphs still run offline.

# --- Core ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=        # from @BotFather. Required for the bot to run.
OPENROUTER_API_KEY=        # LLM calls (command agents) AND voice transcription.

# Voice notes are transcribed via OpenRouter (model mistralai/voxtral-small-24b-2507),
# then routed to a command. Override the model with TRANSCRIBE_MODEL (optional).
# TRANSCRIBE_MODEL=mistralai/voxtral-small-24b-2507
# Bias transcription toward your domain terms so an acronym isn't misheard.
# Comma-separated; add the names/brands/jargon you actually say out loud.
TRANSCRIBE_VOCAB=Optimimer, Notion, Telegram
NOTION_TOKEN=              # OPTIONAL. Notion integration token (share your task DB
                          # with it). If unset, Notion is skipped entirely: write
                          # actions are saved as JSON files on disk instead (see
                          # OPTIMIMER_NOTION_FALLBACK_DIR below), so the bot is
                          # fully usable with no Notion account.

# Two-bucket category buttons (shown when a command asks "which bucket?").
# Defaults are "Sagemesh" / "Personal"; set these to adapt to your own life,
# e.g. CATEGORY_A=Work and CATEGORY_B=Home. Just the button labels — the Notion
# mapping lives in agents/cmd-notion.json (fork it to change the schema).
# CATEGORY_A=Work
# CATEGORY_B=Home

# --- Slash commands -----------------------------------------------------------
# The /notion, /remind, /complete agents write to ONE Notion task database.
# Paste its database id here; agents read it as {{env.LIFEOS_DB_ID}}.
LIFEOS_DB_ID=

# /note files into a "Notes" database and links Topics/Areas (relations).
NOTES_DB_ID=
TOPICS_DB_ID=
AREAS_DB_ID=

# Default timezone for parsing "4pm", "tomorrow", etc. Per-chat overrides come
# from /tz <Area/City> or by sharing your location with /where. Set to yours.
DEFAULT_TZ=UTC

# --- /email (optional) --------------------------------------------------------
# Until both are set, /email just shows a mocked preview instead of sending.
RESEND_API_KEY=            # https://resend.com — used as a bearer token.
EMAIL_FROM=               # verified sender, e.g. "Me <me@yourdomain.com>"

# --- Data file locations (optional; sensible defaults) ------------------------
# OPTIMIMER_DATA=workflows.json
# OPTIMIMER_SCHEDULE_DATA=schedules.json
# OPTIMIMER_TZ_DATA=chat_tz.json
# OPTIMIMER_AGENTS_DIR=agents
# Where Notion writes land when NOTION_TOKEN is unset (one JSON file per action):
# OPTIMIMER_NOTION_FALLBACK_DIR=notion-out
#
# ------------------------------------------------------------------------------
# EXAMPLE DOMAIN SCHEMA — the bundled agents/ target one specific Notion "Tasks"
# data source. This is just the author's setup, kept as a worked example; adapt
# the property names in agents/*.json to match your own database. Properties used:
#   Name              title
#   Category          select    -> e.g. "Sagemesh" | "Personal" (see CATEGORY_A/B)
#   Type              select    -> "Meeting" | "Workout" | "Task" | "Reminder"
#   Date              date      -> meetings get start+end (1h block); others a start
#   Status            status    -> "Not started" | "In progress" | "Done"
#   " Complete"       checkbox  -> NOTE the leading space; this is what the views
#                                  filter on, so /complete and auto-clear set it true
#   "Push to Calendar" checkbox -> set true on meetings to surface them on the calendar
