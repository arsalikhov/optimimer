# Maintainer: Arsali <arsalikhov@users.noreply.github.com>
# Generated by the release workflow for v@VERSION@ — https://github.com/arsalikhov/optimimer
pkgname=optimimer-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Private Telegram assistant that writes to your Obsidian vault (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/arsalikhov/optimimer"
license=('unknown')
depends=('systemd')
optdepends=('etherwake: Wake-on-LAN for registered machines')
provides=('optimimer')
conflicts=('optimimer')
source_x86_64=("$url/releases/download/v$pkgver/optimimer-$pkgver-linux-amd64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/optimimer-$pkgver-linux-arm64.tar.gz")
sha256sums_x86_64=('@SHA_AMD64@')
sha256sums_aarch64=('@SHA_ARM64@')

package() {
  install -Dm755 optimimer-backend "$pkgdir/usr/bin/optimimer-backend"
  install -Dm755 optimimer-setup "$pkgdir/usr/bin/optimimer-setup"
  install -Dm644 agents/*.json -t "$pkgdir/usr/share/optimimer/agents"
  install -Dm644 obsidian-sync.service "$pkgdir/usr/share/optimimer/obsidian-sync.service"
  install -Dm644 optimimer.service "$pkgdir/usr/lib/systemd/system/optimimer.service"
  install -Dm644 optimimer.sysusers "$pkgdir/usr/lib/sysusers.d/optimimer.conf"
  install -Dm644 optimimer.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/optimimer.conf"
  install -Dm644 README.md "$pkgdir/usr/share/doc/optimimer/README.md"
}
