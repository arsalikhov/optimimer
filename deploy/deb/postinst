#!/bin/sh
set -e
if [ "$1" = configure ]; then
  if ! getent group optimimer >/dev/null; then addgroup --system optimimer; fi
  if ! getent passwd optimimer >/dev/null; then
    adduser --system --ingroup optimimer --home /var/lib/optimimer --no-create-home --shell /usr/sbin/nologin optimimer
  fi
  mkdir -p /var/lib/optimimer/vault /etc/optimimer
  chown -R optimimer:optimimer /var/lib/optimimer
  chmod 750 /var/lib/optimimer /etc/optimimer
  chgrp optimimer /etc/optimimer
  systemctl daemon-reload >/dev/null 2>&1 || true
  if [ -f /etc/optimimer/optimimer.env ]; then
    # Upgrade: pick up the new binary.
    systemctl try-restart optimimer >/dev/null 2>&1 || true
  else
    echo
    echo "Optimimer installed. Finish the setup (3 questions) with:"
    echo
    echo "    sudo optimimer-setup"
    echo
  fi
fi
exit 0
